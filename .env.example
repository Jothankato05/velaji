# Copy to .env and fill in for a real deployment.
# For local dev with no MongoDB installed, leave MONGODB_URI unset and set
# ALLOW_IN_MEMORY_DB=true — the server will start an ephemeral in-memory
# MongoDB automatically. Data will NOT persist across restarts.

NODE_ENV=development
PORT=4100

MONGODB_URI=
ALLOW_IN_MEMORY_DB=true

# Base URL this API is reachable at (used to build QR verification links).
APP_BASE_URL=http://localhost:4100

# Secret used to sign card verification tokens (HMAC). Generate a real
# random value for anything beyond local dev:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CARD_SIGNING_SECRET=dev-only-insecure-secret-change-me

# Separate secret for staff bearer tokens — keep it different from
# CARD_SIGNING_SECRET so a leaked QR-verification secret can't be used to
# forge a staff login session.
AUTH_TOKEN_SECRET=dev-only-insecure-auth-secret-change-me
